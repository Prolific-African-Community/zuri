# --- Database (required) ---------------------------------------------------
# Any PostgreSQL instance. Neon works out of the box.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zuri?schema=public"

# --- OpenAI (required for every generation feature) ------------------------
OPENAI_API_KEY=""
# Optional. Text model. Defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"
# Optional. Image model for visuals. Defaults to gpt-image-1.
OPENAI_IMAGE_MODEL="gpt-image-1"

# --- Vercel Blob (required to store generated images) ----------------------
# The store must allow public access; generated visuals are served from its URL.
BLOB_READ_WRITE_TOKEN=""

# --- DataForSEO (required for keyword discovery and SERPs) -----------------
# The API password is generated at app.dataforseo.com/api-access — it is NOT
# the dashboard password. The account must also be verified.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
# Optional. Market targeted by keyword and SERP lookups.
DATAFORSEO_LOCATION_NAME="United States"
DATAFORSEO_LANGUAGE_NAME="English"

# --- Auth (required) -------------------------------------------------------
# Single admin login. AUTH_SECRET signs the session cookie: use a long random
# string (openssl rand -base64 32). Changing it signs everyone out.
AUTH_SECRET=""
AUTH_PASSWORD=""

# --- GitHub (required for the website bridge) -----------------------------
# Fine-grained or classic token with contents:write and pull_requests:write on
# the target repositories. Never stored in the database.
GITHUB_TOKEN=""

# --- Google Search Console (read-only) -------------------------------------
# OAuth client from console.cloud.google.com. The authorised redirect URI must
# be <your origin>/api/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Overrides the redirect URI derived from the request origin.
GOOGLE_REDIRECT_URI=""

# --- Google Ads (read-only test) -------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_MANAGER_CUSTOMER_ID=""
# The advertising account itself is configured per brand, on the brand page.
# Optional. Defaults to v22.
GOOGLE_ADS_API_VERSION="v22"

# Read-only Vercel access, used to confirm a merged article really reached
# production. The project itself is configured per brand.
VERCEL_TOKEN=
# Only for team accounts; leave empty on a personal account.
VERCEL_TEAM_ID=
